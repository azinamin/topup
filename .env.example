# این فایل را کپی کن به .env و مقدارها را پر کن. فایل .env را هرگز commit نکن.
BASE_URL=https://app.mydigipay.com
# شماره‌ای که با آن لاگین می‌کنی
DIGIPAY_MOBILE=09XXXXXXXXX
# شماره‌ای که شارژ می‌گیرد (اگر خالی باشد همان شماره‌ی لاگین)
TOPUP_MOBILE=
# فقط برای حساب تستی با OTP ثابت. خالی = کد پیامکی را خودت در مرورگر می‌زنی
DIGIPAY_OTP=
# اختیاری: توکن (در localStorage گذاشته می‌شود) و اسم کلید آن
DIGIPAY_TOKEN=
DIGIPAY_TOKEN_KEY=token
# فقط روی کامپیوتر خودت: اگر Chromium دانلود نمی‌شود، Chrome نصب‌شده را استفاده کن (chrome)
BROWSER_CHANNEL=
# آدرس API ساخت سفارش (از DevTools > Network پیدا کن). فقط تست‌های mocked استفاده می‌کنند
ORDER_API_GLOB=**/topup/**
# بعد از برگشت از بانک آدرس باید با این regex جور باشد
RETURN_URL_REGEX=mydigipay
